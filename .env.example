# ── Telegram ──────────────────────────────────────────
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=your_ai_bot

# Comma-separated Telegram user IDs for admin access
ADMIN_IDS=123456789

# ── Database ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aichat_bot
POSTGRES_USER=aichat_user
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI (OpenRouter) ────────────────────────────────────
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── YooKassa ───────────────────────────────────────────
# Register at https://yookassa.ru
# ShopID from yookassa dashboard
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# URL пользователь попадает после оплаты (ваш бот)
YOOKASSA_RETURN_URL=https://t.me/your_ai_bot

# ── Webhook server ─────────────────────────────────────
# Публичный URL, куда YooKassa шлёт уведомления
# Настроить в личном кабинете YooKassa → Настройки → HTTP-уведомления
# Пример: https://ai.yourdomain.com/yookassa-webhook
WEBHOOK_BASE_URL=https://ai.yourdomain.com
WEBHOOK_PORT=8080

# ── Подписки (Stars) ───────────────────────────────────
# Сколько Stars стоит каждый план (1 Star ≈ 1 цент = ~0.9₽)
STARS_BASIC_MONTHLY=250
STARS_PRO_MONTHLY=600

# ── Environment ────────────────────────────────────────
# 'development' relaxes strict secret checks for local runs.
ENV=development

# ── Admin dashboard ─────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
ADMIN_SECRET_KEY=
# Public HTTPS URL of the admin dashboard (behind TLS reverse proxy).
ADMIN_BASE_URL=https://ai.yourdomain.com

# ── Прочее ─────────────────────────────────────────────
TIMEZONE=Europe/Moscow

# ── AI providers (optional) ────────────────────────────
FAL_AI_API_KEY=
FAL_BILLING_API_KEY=
OPENAI_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── CryptoBot (optional) ───────────────────────────────
CRYPTOBOT_TOKEN=
