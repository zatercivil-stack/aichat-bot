# секреты / окружение
.env
.env.*
!.env.example

# runtime-данные и сгенерированные ассеты (крупные; содержат чувствительное,
# напр. data/aurum/users.db). Бэкапятся отдельно, в код-репо им не место.
data/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# логи и дампы БД
*.log
*.sql.gz
*.session
*.session-journal

# ОС/редактор
.DS_Store
.idea/
.vscode/

# секрет-файлы — защита от случайного авто-пуша секрета в GitHub
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credential*
*secret*.json
service-account*.json
*.kdbx
